(* .agent/rule/core/format/rule-file-format.ebnf *)
(* ebnf subset version: 1 *)
(* format: two-space indent; rule name, =, expression, and ; use separate lines *)

(* ========================================================================== *)
(* RULE FILE FORMAT                                                           *)
(* ========================================================================== *)

(* path: .agent/rule/<target>/<aspect>/<name>.rule.md *)
rule_file
  = header , body , footer
  ;

(* ========================================================================== *)
(* HEADER                                                                     *)
(* ========================================================================== *)

header
  = path_comment , desc_comment , eol
  ;

path_comment
  = "<!-- @path[", path, "] -->", eol
  ;

desc_comment
  = "<!--", desc, "-->", eol
  ;

path
  = ? a file system path or URL link ?
  ;

desc
  = ? regex:/[^\n\r]*/ ?
  ;

(* ========================================================================== *)
(* BODY                                                                       *)
(* ========================================================================== *)

body
  = body_element , { body_element }
  ;

(*
  NONE.
  - scope : a label declaring the topic of the following list.
  - list  : an unordered list of rules or notes under that scope.
*)
body_element
  = scope , list
  ;

scope
  = ? regex:/[A-Z]+[A-Z ]*/ ?, eol
  ;

list
  = item , { item } , eol
  ;

item
  = "-", text , eol
  ;

(* ========================================================================== *)
(* FOOTER                                                                     *)
(* ========================================================================== *)

footer
  = "---", eol
  ;

(* ========================================================================== *)
(* BASIC ELEMENTS                                                             *)
(* ========================================================================== *)

(*
  NONE.
  - os path or command must use commonmark inline code syntax
    e.g. `/tmp/hi.tmp`, `echo "hello world!"`
  - link must use commonmark link syntax
    e.g. [label](url)
*)
text
  = ? regex:/[^\n\r]*/ ?
  ;

eol
  = "\n"
  | "\r\n"
  ;
