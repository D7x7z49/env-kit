(* .agent/rule/git/branch/branch-naming.ebnf *)
(* ebnf subset version: 1 *)
(* format: two-space indent; rule name, =, expression, and ; use separate lines *)

(* ========================================================================== *)
(* BRANCH NAME                                                                *)
(* ========================================================================== *)

branch_name
  = topic
  | ticket
  ;

(* ========================================================================== *)
(* PLANNED WORK                                                               *)
(* ========================================================================== *)

(* type / [scope-]desc *)
topic
  = type, "/", [ scope, "-" ], desc
  ;

(* a branch type is a word of its own, not a commit type *)
type
  = "feature"
  | "hotfix"
  | "perf"
  ;

desc
  = identifier, { "-", segment }
  ;

(* ========================================================================== *)
(* COMMUNITY TICKET                                                           *)
(* ========================================================================== *)

(* issue or discussion / number *)
ticket
  = kind, "/", number
  ;

kind
  = "issue"
  | "discussion"
  ;

(* ========================================================================== *)
(* BASIC ELEMENTS                                                             *)
(* ========================================================================== *)

scope
  = identifier
  ;

segment
  = identifier
  | number
  ;

number
  = ? regex:/[1-9][0-9]*/ ?
  ;

identifier
  = ? regex:/[A-Za-z][A-Za-z0-9]*/ ?
  ;
